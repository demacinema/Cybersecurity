#!/usr/bin/env python3
# -*- coding: utf-8 -*-

"""Scorpion - Read image files and extract metadata"""

import sys  # Used for exiting the program with a status code
import argparse  # Used for parsing command-line arguments
from pathlib import Path  # Used for handling filesystem paths
from PIL import Image  # Used for opening and inspecting image files


def parse_arguments():
    """Process command-line arguments."""
    parser = argparse.ArgumentParser()

    # One or more positional image files
    parser.add_argument(
        'files',
        nargs='+',
        help='One or more image files to inspect'
    )

    return parser.parse_args()


def validate_input_files(file_paths):
    """ Valida files/path, returns lista validos, print error """

    valid_files = []

    for file_path_str in file_paths:
        file_path = Path(file_path_str)

        # Check existence
        if not file_path.exists():
            print(f"Error: File not found: {file_path_str}", file=sys.stderr)
            continue

        # Check "is_file" and not directory
        if not file_path.is_file():
            print(f"Error: Not a file: {file_path_str}", file=sys.stderr)
            continue

        # Try to see if is readable (permission)
        try:
            if not file_path.stat():
                print(f"Error: Cannot read file: {file_path_str}",
                      file=sys.stderr)
        except PermissionError:
            print(f"Error: Permission denied: {file_path_str}",
                  file=sys.stderr)
            continue
        except OSError as e:
            print(f"Error: Cannot access file {file_path_str}: {e}",
                  file=sys.stderr)
            continue

        # Validate extension
        if not validate_file_extension(file_path):
            continue

        # Valid file
        valid_files.append(file_path)

    return valid_files


def validate_file_extension(file_path):
    """Check if file has the supported extension."""

    supported_extensions = {'.jpg', '.jpeg', '.png', '.gif', '.bmp'}

    ext = file_path.suffix.lower()

    if ext not in supported_extensions:
        print(f"Error: Unsupported format: {file_path.name} ({ext})",
              file=sys.stderr)
        return False

    return True


def open_image_safely(file_path):
    """Try to open image safe, return PIL Image object if ok"""

    try:
        image = Image.open(file_path)
        # Verify the img is valid access its format
        image.verify()
        # Re-open, as verify marks as unusable
        image = Image.open(file_path)
        return image

    except IOError as e:
        print(f"Error: Cannot read image {file_path.name}: {e}",
              file=sys.stderr)
        return None
    except Exception as e:
        print(f"Error: Corrupted or invalid image {file_path.name}: {e}",
              file=sys.stderr)
        return None


def main():
    args = parse_arguments()

    # Parse arguments
    print(f"Files: {args.files}")
    print(f"Total: {len(args.files)}")

    # Validate files
    # Validate extensions
    valid_files = validate_input_files(args.files)
    print(f"Valid files: {len(valid_files)}")

    if not valid_files:
        print("Error: No valid files", file=sys.stderr)
        return 1

    # Test images opening
    opened_images = []
    for file_path in valid_files:
        image = open_image_safely(file_path)
        if image:
            opened_images.append((file_path, image))
        # None print error already

    if not opened_images:
        print("Error: No valid images to be open", file=sys.stderr)
        return 1

    print(f"Successfully open {len(opened_images)} images")
    return 0


if __name__ == '__main__':
    sys.exit(main())
