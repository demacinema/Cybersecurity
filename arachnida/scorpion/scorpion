#!/usr/bin/env python3
# -*- coding: utf-8 -*-

"""Scorpion - Read image files and extract metadata"""

import sys  # Used for exiting the program with a status code
import argparse  # Used for parsing command-line arguments
from pathlib import Path  # Used for handling filesystem paths
from PIL import Image, ExifTags  # Used for opening and inspecting image files
from datetime import datetime  # Used for dates


def parse_arguments():
    """Process command-line arguments."""
    parser = argparse.ArgumentParser()

    # One or more positional image files
    parser.add_argument(
        'files',
        nargs='+',
        help='One or more image files to inspect'
    )

    return parser.parse_args()


def validate_input_files(file_paths):
    """ Valida files/path, returns lista validos, print error """

    valid_files = []

    for file_path_str in file_paths:
        file_path = Path(file_path_str)

        # Check existence
        if not file_path.exists():
            print(f"Error: File not found: {file_path_str}", file=sys.stderr)
            continue

        # Check "is_file" and not directory
        if not file_path.is_file():
            print(f"Error: Not a file: {file_path_str}", file=sys.stderr)
            continue

        # Try to see if is readable (permission)
        try:
            if not file_path.stat():
                print(f"Error: Cannot read file: {file_path_str}",
                      file=sys.stderr)
        except PermissionError:
            print(f"Error: Permission denied: {file_path_str}",
                  file=sys.stderr)
            continue
        except OSError as e:
            print(f"Error: Cannot access file {file_path_str}: {e}",
                  file=sys.stderr)
            continue

        # Validate extension
        if not validate_file_extension(file_path):
            continue

        # Valid file
        valid_files.append(file_path)

    return valid_files


def validate_file_extension(file_path):
    """Check if file has the supported extension."""

    supported_extensions = {'.jpg', '.jpeg', '.png', '.gif', '.bmp'}

    ext = file_path.suffix.lower()

    if ext not in supported_extensions:
        print(f"Error: Unsupported format: {file_path.name} ({ext})",
              file=sys.stderr)
        return False

    return True


def open_image_safely(file_path):
    """Try to open image safe, return PIL Image object if ok"""

    try:
        image = Image.open(file_path)
        # Verify the img is valid access its format
        image.verify()
        # Re-open, as verify marks as unusable
        image = Image.open(file_path)
        return image

    except IOError as e:
        print(f"Error: Cannot read image {file_path.name}: {e}",
              file=sys.stderr)
        return None
    except Exception as e:
        print(f"Error: Corrupted or invalid image {file_path.name}: {e}",
              file=sys.stderr)
        return None


def extract_exif(image, file_path):
    """Extract EXIF metadata, return dict"""

    exif_data = {}

    try:
        exif = image.getexif()

        if not exif:
            return exif_data

        # Convert EXIF tag IDs to readable names
        for tag_id, value in exif.items():
            tag_name = ExifTags.TAGS.get(tag_id, tag_id)

            # Handle GPS Info sub-IFD (nested tags)
            if tag_id == 34853:  # GPSInfo tag ID
                try:
                    gps_ifd = exif.get_ifd(0x8825)  # Get the nested GPS data
                    gps_data = {}
                    for gps_tag_id, gps_value in gps_ifd.items():
                        gps_tag_name = ExifTags.GPSTAGS.get(gps_tag_id,
                                                            gps_tag_id)
                        gps_data[gps_tag_name] = gps_value
                    exif_data[tag_name] = gps_data
                except Exception:
                    exif_data[tag_name] = value
            else:
                exif_data[tag_name] = value

    except Exception as e:
        print(f"Warning: Not able to read EXIF from {file_path.name}: {e}",
              file=sys.stderr)

    return exif_data


def extract_basic_metadata(image, file_path):
    """Extract basic metadata"""

    metadata = {}

    try:
        # Information
        metadata['Filename'] = file_path.name
        metadata['Path'] = str(file_path.absolute())

        # Size in bytes
        stat_info = file_path.stat()
        metadata['Size'] = f"{stat_info.st_size} bytes"

        # Modification date
        mod_time = datetime.fromtimestamp(stat_info.st_mtime)
        metadata['Modified'] = mod_time.strftime('%Y-%m-%d %H:%M:%S')

        # Format
        if image.format:
            metadata['Format'] = image.format
        else:
            metadata['Format'] = "Unknown"

        # Dimensions
        width, height = image.size
        metadata['Dimensions'] = f"{width}x{height} pixels"

    except Exception as e:
        print(f"Error reading basic metadata for {file_path.name}: {e}",
              file=sys.stderr)

    return metadata


def main():
    args = parse_arguments()

    # Parse arguments
    print(f"Files: {args.files}")
    print(f"Total: {len(args.files)}")

    # Validate files
    # Validate extensions
    valid_files = validate_input_files(args.files)
    print(f"Valid files: {len(valid_files)}")

    if not valid_files:
        print("Error: No valid files", file=sys.stderr)
        return 1

    # Test images opening
    opened_images = []
    for file_path in valid_files:
        image = open_image_safely(file_path)
        if image:
            opened_images.append((file_path, image))
        # None print error already

    if not opened_images:
        print("Error: No valid images to be open", file=sys.stderr)
        return 1

    print(f"Successfully open {len(opened_images)} images")

    # Extract and display basic metadata
    for file_path, image in opened_images:
        print(f"\n{'='*60}")
        print(f"File: {file_path.name}")
        print(f"{'='*60}")

        basic_metadata = extract_basic_metadata(image, file_path)
        print("\n[Basic Metadata]")
        for key, value in basic_metadata.items():
            print(f"  {key}: {value}")

        # Extract and display EXIF
        exif_data = extract_exif(image, file_path)
        if exif_data:
            print("\n[EXIF Data]")
            for key, value in exif_data.items():
                if isinstance(value, dict):
                    print(f"  {key}:")
                    for sub_key, sub_value in value.items():
                        print(f"    {sub_key}: {sub_value}")
        else:
            print("\n[EXIF Data]")
            print("  No EXIF data found")

    return 0


if __name__ == '__main__':
    sys.exit(main())
