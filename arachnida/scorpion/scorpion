#!/usr/bin/env python3
# -*- coding: utf-8 -*-

"""Scorpion - Read image files and extract metadata"""

import sys
import argparse


def parse_arguments():
    """Process command-line arguments."""
    parser = argparse.ArgumentParser()

    # One or more positional image files
    parser.add_argument(
        'files',
        nargs='+',
        help='One or more image files to inspect'
    )

    return parser.parse_args()


def main():
    """Main entrypoint (STEP 1 only)."""
    args = parse_arguments()

    # STEP 1 debug output (same spirit as spider)
    print(f"Files: {args.files}")
    print(f"Total: {len(args.files)}")

    # Next steps will validate files/extensions and extract metadata
    return 0


if __name__ == '__main__':
    sys.exit(main())