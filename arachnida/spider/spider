VALID_IMG_EXTENSIONS = {'.jpg', '.jpeg', '.png', '.gif', '.bmp'}


def non_negative_int(value):
    try:
        n = int(value)
    except ValueError as exc:
        raise argparse.ArgumentTypeError("must be an integer") from exc
    if n < 0:
        raise argparse.ArgumentTypeError("must be >= 0")
    return n


