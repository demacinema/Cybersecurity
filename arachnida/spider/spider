def convert_to_absolute_urls(base_url, image_urls):
    """Convert relative image URLs to absolute URLs."""

    absolute_urls = []
    for image_url in image_urls:
        if not image_url:
            continue
        absolute_urls.append(urljoin(base_url, image_url.strip()))
    return absolute_urls


def sanitize_url(url):
    """Percent-encode invalid characters (spaces, unicode) in URL."""
    url = (url or "").strip()
    parts = urlsplit(url)

    safe_path = quote(parts.path, safe="/%:@+~!$&'()*;,=-._")
    safe_query = quote(parts.query, safe="=&%:@+~!$'()*;,/-._")

    return urlunsplit(
        (parts.scheme, parts.netloc,
            safe_path, safe_query, parts.fragment)
    )


def download_image(image_url, output_dir):
    """Download one image and save. Return saved path or None."""

    try:
        safe_url = sanitize_url(image_url)

        req = Request(
            safe_url,
            headers={
                "User-Agent": "Mozilla/5.0",
                "Accept": "image/*,*/*;q=0.8",
            },
        )

        with urlopen(req, timeout=10) as response:
            content = response.read()

        filename = Path(unquote(urlparse(safe_url).path)).name
        if not filename:
            filename = f"image_{int(time.time() * 1000)}.bin"

        output_path = Path(output_dir) / filename

        with open(output_path, 'wb') as f:
            f.write(content)

        print(f"Downloaded: {image_url} -> {output_path}")
        return str(output_path)

    except URLError as e:
        print(f"Error downloading {image_url}: {e}")
        return None
    except Exception as e:
        print(f"Error saving {image_url}: {e}")
        return None


def ensure_output_dir(output_dir):
    """Create output directory if it does not exist."""
    try:
        Path(output_dir).mkdir(parents=True, exist_ok=True)
        return True
    except Exception as e:
        print(f"Error creating directory '{output_dir}': {e}")
        return False


def process_single_page(page_url, output_dir):
    """Download images from a single page (non -r)."""
    html = fetch_page(page_url)
    if not html:
        print("Falha ao baixar página")
        return 0

    images = extract_images(html)
    valid_images = filter_valid_image_urls(images)
    absolute_images = convert_to_absolute_urls(page_url, valid_images)

    print(f"Encontradas {len(images)} imagem(s)")
    print(f"Válidas: {len(valid_images)}")
    print(f"Absolutas: {len(absolute_images)}\n")

    downloaded = 0
    # evita download duplicado da mesma URL na mesma página
    for img in dict.fromkeys(absolute_images):
        if download_image(img, output_dir):
            downloaded += 1

    return downloaded


class LinkParser(HTMLParser):
    """Parser para extrair links (<a href=...>) de HTML."""

    def __init__(self):
        super().__init__()
        self.links = []

    def handle_starttag(self, tag, attrs):
        if tag == 'a':
            for attr, value in attrs:
                if attr == 'href' and value:
                    self.links.append(value)


def extract_links(html):
    """Extrai URLs de links de um HTML."""
    parser = LinkParser()
    try:
        parser.feed(html)
        parser.close()
    except Exception:
        return []
    return parser.links


def normalize_url(url):
    """Remove fragmento para evitar duplicatas."""
    p = urlparse(url)
    return p._replace(fragment='').geturl()


def is_same_domain(url, root_netloc):
    """Permite apenas http(s), e links do mesmo dominio."""
    p = urlparse(url)
    return p.scheme in ('http', 'https') and p.netloc == root_netloc


def process_recursive(start_url, output_dir, max_depth):
    """Crawl recursivo com limite de profundidade."""
    root_netloc = urlparse(start_url).netloc
    queue = deque([(normalize_url(start_url), 0)])
    visited_pages = set()
    downloaded_images = set()
    downloaded_count = 0

    while queue:
        page_url, depth = queue.popleft()
        if page_url in visited_pages:
            continue
        visited_pages.add(page_url)

        print(f"[Depth {depth}] {page_url}")
        html = fetch_page(page_url)
        if not html:
            continue

        # Baixa imgs da pagina atual
        images = extract_images(html)
        valid_images = filter_valid_image_urls(images)
        absolute_images = convert_to_absolute_urls(page_url, valid_images)

        for img_url in dict.fromkeys(absolute_images):
            img_url = normalize_url(img_url)
            if img_url in downloaded_images:
                continue
            if download_image(img_url, output_dir):
                downloaded_images.add(img_url)
                downloaded_count += 1

        # Se atingiu limite, não expande links desta página
        if depth >= max_depth:
            continue

        # Descobre próximas páginas
        links = extract_links(html)
        absolute_links = convert_to_absolute_urls(page_url, links)

        for link in absolute_links:
            link = normalize_url(link.strip())
            if is_same_domain(link, root_netloc) and link not in visited_pages:
                queue.append((link, depth + 1))

    return downloaded_count


def main():
    """Função principal"""
    args = parse_arguments()

    # Testa args
    print(f"URL: {args.url}")
    print(f"Recursive: {args.rec}")
    print(f"Level: {args.level}")
    print(f"Path: {args.path}")
    print()

    # Garante que o path exista (se não tiver, cria):
    if not ensure_output_dir(args.path):
        sys.exit(1)

    # Se não for recursivo, processa apenas a página única
    if not args.rec:
        downloaded = process_single_page(args.url, args.path)
        print(f"\nBaixadas: {downloaded}")
        return

    # default da recursão sem -l = 5
    max_depth = args.level if args.level is not None else 5
    downloaded = process_recursive(args.url, args.path, max_depth)
    print(f"Baixadas: {downloaded}\n")


